# EXAMPLE ONLY - never commit .env
DJANGO_SECRET_KEY=replace-me-in-private-env
DJANGO_DEBUG=false
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/bazaar
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Neshan paid routing: ALL THREE limits/flags must be approved before enabling.
# REST key is private/backend only. Do not commit real keys.
NESHAN_ROUTING_ENABLED=0
# Enable only after validating Direction scope and billable budget.
NESHAN_DIRECTION_ENABLED=0
NESHAN_ROUTING_API_KEY=
NESHAN_ROUTING_MAX_CALLS_PER_MISSION=0
NESHAN_ROUTING_DAILY_MAX_CALLS=0
# React/OpenLayers Web Map SDK requires a SEPARATE domain-scoped key; not used yet.

# Starcoach hackathon BoxAPI adapter (local/private .env only):
# LLM_ENABLED=1
# LLM_PROVIDER=boxapi
# LLM_API_KEY=YOUR_PRIVATE_BOXAPI_KEY
# LLM_MODEL=gpt-5.4-mini
