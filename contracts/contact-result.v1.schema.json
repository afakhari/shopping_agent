{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bazaar Compass Seller Contact Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "mission_id",
    "shop_id",
    "offer_id",
    "channel",
    "status",
    "questions",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "shop_id": {
      "type": "string",
      "minLength": 1
    },
    "offer_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": [
        "simulator",
        "phone",
        "messenger",
        "website"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "no_answer",
        "unavailable",
        "price_changed",
        "closed",
        "unknown",
        "error"
      ]
    },
    "questions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "stock",
          "price",
          "hours"
        ]
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_price_toman": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "stock_confirmed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "open_for_visit": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  }
}
