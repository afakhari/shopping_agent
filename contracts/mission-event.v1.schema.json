{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afakhari/shopping_agent/blob/main/contracts/mission-event.v1.schema.json",
  "title": "Bazaar Compass Mission Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "seq",
    "event_type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "mission.created",
        "intent.parsed",
        "clarification.required",
        "products.found",
        "product.selected",
        "shops.found",
        "contact.approval_required",
        "contact.started",
        "contact.completed",
        "recovery.suggested",
        "visit_plan.ready",
        "mission.failed"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
