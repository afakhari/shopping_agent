{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bazaar Compass Visit Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "product_id",
    "shop_id",
    "offer_id",
    "contact_status",
    "created_at",
    "address",
    "price"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "shop_id": {
      "type": "string",
      "minLength": 1
    },
    "offer_id": {
      "type": "string",
      "minLength": 1
    },
    "contact_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "not_confirmed",
        "simulated_confirmed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "address": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "mall": {
          "type": [
            "string",
            "null"
          ]
        },
        "floor": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ]
        },
        "lng": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "price": {
      "type": "object",
      "required": [
        "registered_price_toman"
      ],
      "properties": {
        "registered_price_toman": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "contact_price_toman": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "registered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "backup_shop_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "navigation_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "opening_hours_label": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
